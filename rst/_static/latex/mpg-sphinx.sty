%% Thin Sphinx adapter for the MPG classical presentation package.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mpg-sphinx}[2026/08/09 Sphinx adapter for MPG classical PDF]

\RequirePackage{mpg-classic}

% Small mathematical vocabulary retained from the original MPG macros.  Most
% legacy notation is now written directly in reST math; these three commands
% remain in a handful of faithful source passages and are intentionally kept
% here rather than importing the old PSTricks-heavy macro file.
\providecommand{\reifyeqv}[2]{#1=\mathtt 1\Leftrightarrow #2}
\providecommand{\reifyimp}[2]{#1=\mathtt 1\Rightarrow #2}
\providecommand{\reifypmi}[2]{#1=\mathtt 1\Leftarrow #2}
\providecommand{\RR}{\ensuremath{\mathbb R}}
\providecommand{\arcsinh}{\operatorname{arcsinh}}
\providecommand{\arccosh}{\operatorname{arccosh}}
\providecommand{\arctanh}{\operatorname{arctanh}}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

\makeatletter
\renewcommand{\sphinxmaketitle}{%
  \let\sphinxrestorepageanchorsetting\relax
  \ifHy@pageanchor\def\sphinxrestorepageanchorsetting{\Hy@pageanchortrue}\fi
  \hypersetup{pageanchor=false,pdfauthor={\@author},pdftitle={\@title}}%
  \begin{titlepage}
    \thispagestyle{empty}
    \vspace*{1in}
    \begin{flushright}
      \MPGLogo\par
      \vspace*{1.5in}
      {\MPGBigTitle\bfseries\@title\par}
      \vspace*{3em}
      {\color{GecodeGreen}\href{mailto:schulte@gecode.dev}{Christian Schulte}\par}
      \medskip
      {\color{GecodeGreen}\href{mailto:tack@gecode.dev}{Guido Tack}\par}
      \medskip
      {\color{GecodeGreen}\href{mailto:lagerkvist@gecode.dev}{Mikael Z.\ Lagerkvist}\par}
    \end{flushright}
  \end{titlepage}
  \setcounter{footnote}{0}%
  \clearpage
  \ifdefined\sphinxbackoftitlepage\sphinxbackoftitlepage\fi
  \if@openright\cleardoublepage\else\clearpage\fi
  \sphinxrestorepageanchorsetting}

