% Small mathematical vocabulary retained from the original MPG macros.  Most
% legacy notation is now written directly in reST math; these three commands
% remain in a handful of faithful source passages and are intentionally kept
% here rather than importing the old PSTricks-heavy macro file.
\providecommand{\reifyeqv}[2]{#1=\mathtt 1\Leftrightarrow #2}
\providecommand{\reifyimp}[2]{#1=\mathtt 1\Rightarrow #2}
\providecommand{\reifypmi}[2]{#1=\mathtt 1\Leftarrow #2}
\providecommand{\RR}{\ensuremath{\mathbb R}}
\providecommand{\arcsinh}{\operatorname{arcsinh}}
\providecommand{\arccosh}{\operatorname{arccosh}}
\providecommand{\arctanh}{\operatorname{arctanh}}
\DeclareMathOperator*{\argmin}{arg\,min}
\DeclareMathOperator*{\argmax}{arg\,max}

