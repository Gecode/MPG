% The old Figures list intentionally combined illustrations, tables presented
% as figures, and numbered program listings.  Sphinx gives programs their own
% counter; sharing the .lof preserves the distinct Program numbers while
% restoring the established combined list.
\renewcommand*{\ext@literalblock}{lof}
\newcommand*{\l@literalblock}{\@dottedtocline{1}{1.5em}{3em}}
\newcommand*{\ext@mpgtip}{lotip}
\newcommand*{\l@mpgtip}{\@dottedtocline{1}{1.5em}{3em}}
\newcommand{\listoftips}{%
  \chapter*{Tips}%
  \@mkboth{\MakeUppercase{Tips}}{\MakeUppercase{Tips}}%
  \@starttoc{lotip}}

\renewcommand{\sphinxtableofcontents}{%
  \pagenumbering{Roman}%
  \pagestyle{plain}%
  \begingroup
    \parskip\z@skip
    \phantomsection\pdfbookmark{Contents}{contents}%
    \renewcommand*{\@pnumwidth}{2em}%
    \sphinxtableofcontentshook
    \tableofcontents
  \endgroup
  \cleardoublepage
  \begingroup
    \renewcommand{\listfigurename}{Figures}%
    \renewcommand*{\l@figure}{\@dottedtocline{1}{1.5em}{3em}}%
    \renewcommand*{\@pnumwidth}{2em}%
    \phantomsection\pdfbookmark{Figures}{figures}%
    \listoffigures
  \endgroup
  \cleardoublepage
  \begingroup
    \renewcommand*{\@pnumwidth}{2em}%
    \phantomsection\pdfbookmark{Tips}{tips}%
    \listoftips
  \endgroup
  \cleardoublepage
  \pagenumbering{arabic}%
  \pagestyle{plain}}

\hypersetup{
  pdflang={en-GB},
  pdfdisplaydoctitle=true,
  pdfsubject={Constraint programming},
  pdfkeywords={Gecode, constraint programming, constraint solving, modeling,
    constraints, search, propagators, branchers}}

\renewcommand{\sphinxcrossref}[1]{#1}
% MPG used a run-in ``Important.`` paragraph, not an icon-bearing callout.
% Keeping that vocabulary also removes a misleading pause-circle glyph from
% both the visual page and extracted text.
\renewenvironment{sphinximportant}[1]{%
  \begin{trivlist}\item\relax
  \textbf{\sphinxremovefinalcolon{#1}.}\enspace\ignorespaces
}{\end{trivlist}}
\AtBeginDocument{%
  \setlength{\parindent}{15pt}%
  \setlength{\parskip}{0pt plus 1pt}}

\@ifpackageloaded{fancyhdr}{%
  \fancypagestyle{plain}{%
    \fancyhf{}\fancyfoot[C]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}}
  \fancypagestyle{normal}{%
    \fancyhf{}\fancyfoot[C]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}}}{}
\makeatother

