---
interface Props { title: string; release: string }
const { title, release } = Astro.props;
import 'katex/dist/katex.min.css';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>{title} - MPG</title></head>
  <body>
    <header><a href="/">Gecode</a><span>Modeling and Programming</span><small>Release {release}</small></header>
    <main><nav aria-label="Book"><a href="../first-page/">A first model</a><a href="../second-page/">Cross-page semantics</a></nav><article><slot /></article></main>
  </body>
</html>
