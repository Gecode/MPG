---
import 'katex/dist/katex.min.css';

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} — MPG MyST/Astro spike</title>
  </head>
  <body>
    <header class="site-header">
      <a href="/doc/6.4.0/modeling/">Gecode documentation prototype</a>
      <nav>
        <a href="/doc/6.4.0/modeling/overview/">Overview</a>
        <a href="/doc/6.4.0/modeling/crossword/">Crossword</a>
        <a href="/doc/6.4.0/modeling/nonogram/">Nonogram</a>
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>

<style is:global>
  :root {
    color: #14221c;
    background: #fbfcf9;
    font-family: "Open Sans", Arial, Helvetica, sans-serif;
  }
  body { margin: 0; }
  .site-header {
    display: flex;
    justify-content: space-between;
    padding: 1rem clamp(1rem, 4vw, 4rem);
    color: white;
    background: #0b7646;
  }
  .site-header nav { display: flex; gap: 1rem; }
  .site-header a { color: inherit; }
  main { max-width: 72rem; margin: 0 auto; padding: 2rem clamp(1rem, 4vw, 4rem); }
  .mpg-document { max-width: 52rem; padding: 2rem; border-top: 3px solid #0b7646; background: white; box-shadow: 0 1rem 3rem #14221c12; }
  .mpg-document h1, .mpg-document h2, .mpg-document h3 { color: #075331; font-family: Raleway, Verdana, sans-serif; }
  .mpg-document a { color: #075f9f; }
  .mpg-document img { display: block; max-width: 100%; margin-inline: auto; }
  .mpg-document figure { margin: 2rem 0; }
  .mpg-document figcaption { margin-top: .75rem; color: #475569; }
  .mpg-document p, .mpg-document li { line-height: 1.65; }
  .mpg-document pre { overflow-x: auto; padding: 1rem; color: #eef8f2; background: #142f26; font-family: "Roboto Mono", ui-monospace, monospace; }
  .code-filename { padding: .5rem 1rem; color: #d5e7dc; background: #075331; font: 600 .85rem "Roboto Mono", ui-monospace, monospace; }
  .equation { display: grid; grid-template-columns: 1fr auto; align-items: center; }
  .equation figcaption { color: inherit; }
  .section-number, .caption-number { margin-right: .4em; font-variant-numeric: tabular-nums; }
  .admonition { margin: 1.5rem 0; padding: .25rem 1rem; border-left: .3rem solid #2563eb; background: #eff6ff; }
  .admonition-title { font-weight: 700; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: .65rem; border: 1px solid #cbd5e1; }
  th { background: #f1f5f9; text-align: left; }
  .gecode-api code { color: #1d4ed8; }
</style>
