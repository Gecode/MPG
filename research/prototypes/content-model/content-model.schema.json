{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.gecode.dev/schemas/mpg-content-model-0.1.json",
  "title": "MPG format-neutral content model prototype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_version",
    "repository_root",
    "publication",
    "pages",
    "code_artifacts",
    "validation_profiles",
    "figure_assets"
  ],
  "properties": {
    "model_version": { "const": "0.1" },
    "repository_root": { "type": "string", "minLength": 1 },
    "publication": { "$ref": "#/$defs/publication" },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    },
    "code_artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/codeArtifact" }
    },
    "validation_profiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/validationProfile" }
    },
    "figure_assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/figureAsset" }
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._:/-][a-z0-9]+)*$"
    },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "authors", "license", "gecode", "navigation"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "license": { "$ref": "#/$defs/nonEmptyString" },
        "gecode": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "ref"],
          "properties": {
            "version": { "$ref": "#/$defs/nonEmptyString" },
            "ref": { "$ref": "#/$defs/nonEmptyString" }
          }
        },
        "navigation": {
          "type": "array",
          "items": { "$ref": "#/$defs/navigationPart" }
        },
        "bibliography_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "navigationPart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "page_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "page_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/stableId" }
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "slug", "title", "blocks"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:/[a-z0-9-]+)*$" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "short_title": { "$ref": "#/$defs/nonEmptyString" },
        "authors": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "legacy_urls": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/proseBlock" },
              { "$ref": "#/$defs/headingBlock" },
              { "$ref": "#/$defs/mathBlock" },
              { "$ref": "#/$defs/codeProjection" },
              { "$ref": "#/$defs/figureBlock" }
            ]
          }
        }
      }
    },
    "proseBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "text"],
      "properties": {
        "type": { "const": "prose" },
        "text": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "headingBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "level", "title"],
      "properties": {
        "type": { "const": "heading" },
        "id": { "$ref": "#/$defs/stableId" },
        "level": { "type": "integer", "minimum": 2, "maximum": 6 },
        "title": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "mathBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source"],
      "properties": {
        "type": { "const": "math" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "display": { "type": "boolean", "default": true }
      }
    },
    "codeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "artifact_id", "region_id", "presentation"],
      "properties": {
        "type": { "const": "code_projection" },
        "id": { "$ref": "#/$defs/stableId" },
        "artifact_id": { "$ref": "#/$defs/stableId" },
        "region_id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "presentation": { "enum": ["normal", "compact", "direct"] },
        "show_download": { "type": "boolean", "default": false },
        "fold_overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/stableId" },
          "additionalProperties": {
            "enum": ["expanded", "linked", "ellipsis", "hidden", "display-only"]
          }
        }
      }
    },
    "figureBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "figure_id"],
      "properties": {
        "type": { "const": "figure" },
        "figure_id": { "$ref": "#/$defs/stableId" }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "start_line", "end_line"],
      "properties": {
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "start_line": { "type": "integer", "minimum": 1 },
        "end_line": { "type": "integer", "minimum": 1 }
      }
    },
    "codeRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "parent_id", "source_span", "emission", "default_projection"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "parent_id": {
          "oneOf": [
            { "$ref": "#/$defs/stableId" },
            { "type": "null" }
          ]
        },
        "source_span": { "$ref": "#/$defs/sourceSpan" },
        "emission": { "enum": ["include", "exclude"] },
        "default_projection": {
          "enum": ["expanded", "linked", "ellipsis", "hidden", "display-only"]
        }
      }
    },
    "codeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "output_path",
        "language",
        "authors",
        "license",
        "generation",
        "regions",
        "validation_profile_ids"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "output_path": { "$ref": "#/$defs/nonEmptyString" },
        "language": { "$ref": "#/$defs/nonEmptyString" },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "license": { "$ref": "#/$defs/nonEmptyString" },
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["strategy", "source_paths"],
          "properties": {
            "strategy": { "enum": ["canonical-file", "fragment-assembly", "legacy-literate"] },
            "source_paths": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/nonEmptyString" }
            }
          }
        },
        "required_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/codeRegion" }
        },
        "validation_profile_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stableId" }
        },
        "legacy_urls": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "compileUnit": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "artifact-output" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "path" },
            "path": { "$ref": "#/$defs/nonEmptyString" }
          }
        }
      ]
    },
    "validationProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "artifact_id", "mode", "compile"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "artifact_id": { "$ref": "#/$defs/stableId" },
        "mode": {
          "enum": ["compile-only", "run", "test-harness", "interactive", "expected-failure"]
        },
        "compile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["units", "cpp_standard", "gecode_components"],
          "properties": {
            "units": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/compileUnit" }
            },
            "cpp_standard": { "type": "integer", "enum": [17, 20, 23] },
            "gecode_components": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/stableId" }
            },
            "flags": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "execute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["arguments", "timeout_seconds", "automated"],
          "properties": {
            "arguments": {
              "type": "array",
              "items": { "type": "string" }
            },
            "timeout_seconds": { "type": "integer", "minimum": 1 },
            "automated": { "type": "boolean" }
          }
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exit_codes"],
          "properties": {
            "exit_codes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "integer" }
            },
            "registered_tests_min": { "type": "integer", "minimum": 1 },
            "stdout_contains": { "type": "string" }
          }
        },
        "reason": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "figureAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "caption", "alt", "source", "derivatives"],
      "properties": {
        "id": { "$ref": "#/$defs/stableId" },
        "caption": { "$ref": "#/$defs/nonEmptyString" },
        "alt": { "$ref": "#/$defs/nonEmptyString" },
        "source": { "$ref": "#/$defs/nonEmptyString" },
        "derivatives": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/nonEmptyString" }
        },
        "license": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
