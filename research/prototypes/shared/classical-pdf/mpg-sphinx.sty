%% Sphinx adapter for mpg-classic.sty.  Keep this file thin: semantics belong
%% in Sphinx/reST; shared visual grammar belongs in mpg-classic.sty.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mpg-sphinx}[2026/08/09 Sphinx adapter for MPG classical PDF]

\RequirePackage{mpg-classic}

\makeatletter

%% Recreate the deliberately spare original title page while retaining the
%% Sphinx metadata and back-of-title hooks.
\renewcommand{\sphinxmaketitle}{%
  \let\sphinxrestorepageanchorsetting\relax
  \ifHy@pageanchor\def\sphinxrestorepageanchorsetting{\Hy@pageanchortrue}\fi
  \hypersetup{pageanchor=false,pdfauthor={\@author},pdftitle={\@title}}%
  \begin{titlepage}
    \thispagestyle{empty}
    \vspace*{1in}
    \begin{flushright}
      \MPGLogo\par
      \vspace*{1.5in}
      {\MPGBigTitle\bfseries\@title\par}
      \vspace*{3em}
      {\large\@author\par}
      \vfill
      {\large Gecode \py@release\par}
      \vspace*{1in}
    \end{flushright}
  \end{titlepage}
  \setcounter{footnote}{0}%
  \clearpage
  \ifdefined\sphinxbackoftitlepage\sphinxbackoftitlepage\fi
  \if@openright\cleardoublepage\else\clearpage\fi
  \sphinxrestorepageanchorsetting}

%% Match the historic plain pages: no running title, centered folio, no rule.
\@ifpackageloaded{fancyhdr}{%
  \fancypagestyle{plain}{%
    \fancyhf{}\fancyfoot[C]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}}
  \fancypagestyle{normal}{%
    \fancyhf{}\fancyfoot[C]{\thepage}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0pt}}}{}

\makeatother

%% Use Sphinx's public styling API for programs and tips.  This preserves its
%% breakable boxes and line-number machinery instead of replacing the writer.
\fvset{fontfamily=fvm}
\let\MPGSphinxOriginalVerbatim\OriginalVerbatim
\renewcommand{\OriginalVerbatim}{%
  \fontencoding{T1}\fontfamily{fvm}\selectfont\MPGSphinxOriginalVerbatim}
\renewcommand{\literalblockname}{\textcolor{GecodeRed}{\MPGProgramLabel}\space}
\sphinxsetup{
  VerbatimColor={named}{GecodeOrangeOp20},
  VerbatimBorderColor={named}{GecodeOrange},
  verbatimborder=0.4pt,
  div.tip_border-TeXcolor=GecodeBlue,
  div.tip_background-TeXcolor=GecodeBlueOp10,
  div.tip_title-background-TeXcolor=GecodeBlueOp20,
  div.tip_title-foreground-TeXcolor=GecodeBlue,
  div.tip_title-icon={},
  div.tip_border-radius=2pt,
  div.tip_box-shadow=none,
  div.note_title-icon={}
}

\endinput
