%% Classical PDF design for Modeling and Programming with Gecode.
%%
%% This is deliberately a small presentation package.  It contains no
%% PSTricks illustrations and no authoring-system-specific commands.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mpg-classic}[2026/08/09 MPG classical book design]

\RequirePackage{xcolor}
\RequirePackage{etoolbox}
\RequirePackage{amssymb}
\RequirePackage{graphicx}

\definecolor{GecodeGreen}{rgb}{0.04314,0.46275,0.27451}
\definecolor{GecodeBlue}{rgb}{0,0.36078,0.631273}
\definecolor{GecodeRed}{rgb}{0.8549,0.1451,0.1137255}
\definecolor{GecodeOrange}{rgb}{0.9216,0.537255,0.10588}
\colorlet{GecodeGreenOp20}{GecodeGreen!20}
\colorlet{GecodeBlueOp10}{GecodeBlue!10}
\colorlet{GecodeBlueOp20}{GecodeBlue!20}
\colorlet{GecodeBlueOp30}{GecodeBlue!30}
\colorlet{GecodeBlueOp40}{GecodeBlue!40}
\colorlet{GecodeRedOp20}{GecodeRed!20}
\colorlet{GecodeOrangeOp20}{GecodeOrange!20}

\newcommand{\MPGBigNumber}{\fontsize{1in}{1in}\selectfont}
\newcommand{\MPGBigTitle}{\fontsize{.45in}{.48in}\selectfont}
\newcommand{\MPGPartAuthors}{}
\newcommand{\MPGPartBlurb}{}
\newcommand{\MPGSetPartAuthors}[1]{\gdef\MPGPartAuthors{#1}}
\newcommand{\MPGSetPartBlurb}[1]{\gdef\MPGPartBlurb{#1}}
%% Set the one-based historical part number explicitly (13 prints as M).
\newcommand{\MPGPartNumber}[2]{%
  \setcounter{part}{\numexpr#1-1\relax}\part{#2}}

%% Public atoms used by backend adapters as well as by a standalone LaTeX book.
\newcommand{\MPGNumberBox}[3]{%
  \begingroup\setlength{\fboxsep}{14pt}\setlength{\fboxrule}{.1pt}%
  \fcolorbox{#1}{#2}{\bfseries\MPGBigNumber\strut\vphantom{A}#3}%
  \endgroup}
\newcommand{\MPGProgramLabel}{Program}
\newcommand{\MPGTipLabel}{Tip}
\newcommand{\MPGLogo}{%
  \IfFileExists{gecode-logo.pdf}{\includegraphics[width=.38\textwidth]{gecode-logo.pdf}}{}}
\newcommand{\MPGCodeFont}{\fontencoding{T1}\fontfamily{fvm}\selectfont}
\newcounter{mpgtip}[chapter]
\renewcommand{\thempgtip}{\thechapter.\arabic{mpgtip}}
\newenvironment{MPGTip}[1]{%
  \par\medskip\refstepcounter{mpgtip}\noindent
  \textbf{\MPGTipLabel~\thempgtip\space (#1).}\enspace\ignorespaces
}{%
  \unskip\hfill$\blacktriangleleft$\par\medskip}

\makeatletter

%% Keep the historical Charter face when compiling with XeLaTeX/LuaLaTeX.
%% Charter is shipped by macOS and common TeX installations.  Fall back to
%% XCharter, then retain the document's existing serif face.
\@ifpackageloaded{fontspec}{%
  \IfFontExistsTF{Charter}{\setmainfont{Charter}}{%
    \IfFontExistsTF{XCharter}{\setmainfont{XCharter}}{}}%
  %% DejaVu Sans Mono is the maintained descendant of Bitstream Vera Sans
  %% Mono, from which Bera Mono was derived.
  \IfFontExistsTF{Bera Sans Mono}{\setmonofont[Scale=0.88]{Bera Sans Mono}}{%
    \IfFontExistsTF{DejaVu Sans Mono}{\setmonofont[Scale=0.88]{DejaVu Sans Mono}}{}}%
}{\RequirePackage[scaled=0.88]{beramono}}

\renewcommand\thepart{\Alph{part}}

\newlength{\MPGChapterNumberWidth}
\newlength{\MPGChapterRestWidth}

\def\@makechapterhead#1{%
  \vspace*{20\p@}%
  {\parindent\z@\raggedright\normalfont
    \ifnum\c@secnumdepth>\m@ne
      \settowidth{\MPGChapterNumberWidth}{%
        \MPGNumberBox{GecodeBlue}{GecodeBlueOp40}{\thechapter}}%
      \setlength{\MPGChapterRestWidth}{\textwidth}%
      \addtolength{\MPGChapterRestWidth}{-\MPGChapterNumberWidth}%
      \addtolength{\MPGChapterRestWidth}{-40pt}%
      \parbox[t]{\MPGChapterNumberWidth}{%
        \MPGNumberBox{GecodeBlue}{GecodeBlueOp40}{\thechapter}}%
    \fi
    \interlinepenalty\@M
    \hfill\parbox[b]{\MPGChapterRestWidth}{%
      \raggedleft\MPGBigTitle\bfseries #1}%
    \par\nobreak\vskip40\p@}}

\def\@makeschapterhead#1{%
  \vspace*{20\p@}%
  {\parindent\z@\raggedright\normalfont\interlinepenalty\@M
   \MPGBigTitle\bfseries #1\par\nobreak\vskip40\p@}}

\def\@part[#1]#2{%
  \ifnum\c@secnumdepth>-2\relax
    \refstepcounter{part}%
    \addcontentsline{toc}{part}{\thepart\hspace{1em}#1}%
  \else
    \addcontentsline{toc}{part}{#1}%
  \fi
  \markboth{}{}\thispagestyle{empty}%
  {\raggedleft\interlinepenalty\@M\normalfont
   \ifnum\c@secnumdepth>-2\relax
     \MPGNumberBox{GecodeOrange}{GecodeOrangeOp20}{\thepart}%
     \vskip60\p@
   \fi
   {\MPGBigTitle\bfseries #2}\par\bigskip
   {\large\bfseries\MPGPartAuthors}\par}%
  \@endpart}

\def\@spart#1{%
  {\centering\interlinepenalty\@M\normalfont\Huge\bfseries #1\par}%
  \@endpart}

\def\@endpart{%
  \vfil\newpage
  \if@twoside
    \if@openright
      \null\thispagestyle{empty}\MPGPartBlurb\newpage
    \else
      \ifx\MPGPartBlurb\@empty\else
        \thispagestyle{empty}\MPGPartBlurb\newpage
      \fi
    \fi
  \else
    \ifx\MPGPartBlurb\@empty\else
      \thispagestyle{empty}\MPGPartBlurb\newpage
    \fi
  \fi
  \MPGSetPartAuthors{}\MPGSetPartBlurb{}%
  \if@tempswa\twocolumn\fi}

\makeatother

\endinput
